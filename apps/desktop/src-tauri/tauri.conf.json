{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "World Compass",
  "version": "0.5.0",
  "identifier": "dev.worldcompass.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "World Compass",
        "width": 1280,
        "height": 880,
        "minWidth": 840,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": [
      "../../../resources/legal/*"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "shortDescription": "Local world search with synthetic development catalog",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Japanese",
          "English"
        ],
        "displayLanguageSelector": true
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
